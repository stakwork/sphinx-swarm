RUST_ENV=development
# Set RUST_ENV=fluentd to route managed-container logs through the Fluent Bit
# sidecar (rate-limited CloudWatch). Default remains development/local.

# Docker fluentd driver → sidecar. Default localhost:24224 if unset.
# FLUENTD_ADDRESS=localhost:24224
# Leave FLUENTD_TAG at its default ({{.Name}}). The Lua rate limiter keys on
# the daemon-set container_name field; a static tag is unsupported for
# per-container throttling.
# FLUENTD_TAG={{.Name}}

# Fluent Bit sidecar must log with json-file + rotation, never fluentd
# (stdout notices would loop into INPUT 24224). See fluent-bit/docker-compose.yml.

# Hourly budget window. Short windows cannot tell a healthy 15k/s burst
# from a loop; hourly bounds blast radius and resets 24×/day.
# FLUENTBIT_RATE_LIMIT_INTERVAL=3600
# Default per-container byte cap (primary; maps to ingest $).
# 67108864 = 64 MiB/hr → ~1.55 GiB/day. repo2graph/boltwall need more (see BYTE_OVERRIDES).
# FLUENTBIT_RATE_LIMIT_BYTES=67108864
# Per-container byte-cap overrides, format name=integer,name2=integer2
# FLUENTBIT_RATE_LIMIT_BYTE_OVERRIDES=repo2graph.sphinx=1073741824,boltwall.sphinx=268435456
# Default per-container records-per-interval cap (secondary).
# FLUENTBIT_RATE_LIMIT_DEFAULT=500000
# Per-container record-cap overrides, format name=integer,name2=integer2
# FLUENTBIT_RATE_LIMIT_OVERRIDES=repo2graph.sphinx=8000000
# Distinct container keys tracked by the Lua filter.
# FLUENTBIT_RATE_LIMIT_MAX_KEYS=256

# Docker fluentd in-memory buffer bound (bytes) if the sidecar is down. Default 1048576 (1MiB).
# FLUENTD_BUFFER_LIMIT=1048576

# CloudWatch group is /swarms/{SWARM_NUMBER} (see SWARM_NUMBER below).
# AWS credentials: prefer IMDS/instance-role. Static keys only from a secret
# store — never commit real values.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# Port where Swarm is going to be running on
ROCKET_PORT=8888

# To run ONLY graph mindset
GRAPH_MINDSET_ONLY=true

# To run ONLY second brain
# SECOND_BRAIN_ONLY=true

NO_REMOTE_SIGNER=true
FEATURE_FLAG_TEXT_EMBEDDINGS=true
AWS_REGION=us-east-1

# For Boltwall connection to Jarvis
BOLTWALL_URL=http://localhost:8444
BOLTWALL_TESTING_FREE=true
NO_LND=true

# For Jarvis connection to Stakwork
JARVIS_STAKWORK_URL=http://host.docker.internal:3333
STAKWORK_WEBSOCKET_URL=wss://host.docker.internal:3333
STAKWORK_ADD_NODE_TOKEN=STAKWORK_CUSTOMER_TOKEN_HERE
STAKWORK_RADAR_REQUEST_TOKEN=STAKWORK_CUSTOMER_TOKEN_HERE
#Graph Mindset Workflow ID
SINGLE_AUDIO_OR_VIDEO_EPISODE_WORKFLOW_ID=STAKWORK_GRAPH_MINDSET_WORKFLOW_ID_HERE
LOCAL_STAKWORK=true
BOLTWALL_URL_FOR_STAKWORK=http://host.docker.internal:8444

YOUTUBE_API_TOKEN="YOUTUBE_API_TOKEN"
TWITTER_BEARER="TWITTER_API_TOKEN"

SWARM_UPDATER_PASSWORD="-"
JARVIS_FEATURE_FLAG_SCHEMA=true
FEATURE_FLAG_ADD_NODE_KEY=true

JARVIS_WORKERS=1
SEED=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
GITHUB_REQUEST_TOKEN="REPLACE_ME"
AUTO_RESTART_CRON_TIME= "0 25 22 * * *"
RADAR_TWITTER_SCHEDULER_TIME_IN_SEC=180
MAX_REQUEST_SIZE=10mb
BOLTWALL_TESTING=Testing
BOLTWALL_TRIAL="WE are Good"
BOLTWALL_API_SECRET=BOLTWALL_API_SECRET
BOLTWALL_MIN_AMOUNT=20000000
PASSWORD="password"
GITHUB_PAT=GITHUB_PAT
LOG_TAIL_LENGTH=1000
SWARM_NUMBER="LOCAL_SWARM"
RUST_LOG=info,aws_config=warn,aws_smithy=warn